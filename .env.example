# Environment contract.
#
# Copy to .env.local and fill in. Never commit a filled-in copy — .gitignore
# excludes every .env file except this one.
#
# Values are validated with Zod at startup (packages/validation/src/env). A
# missing or malformed variable fails immediately with a list of every problem,
# rather than surfacing weeks later as an undefined in a connection string.

# --- Application -------------------------------------------------------------

# development | preview | production
APP_ENV=development

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
# Project settings → API. The anon key is public by design; the service-role key
# is not, and must never appear in a NEXT_PUBLIC_ variable or a client bundle.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres ----------------------------------------------------------------
# Two connection strings, and the difference matters.
#
# DATABASE_URL is the transaction pooler (port 6543). Application requests use
# it. It does not support prepared statements, which the client accounts for.
#
# DIRECT_URL is a session-mode connection (port 5432). Migrations, seeds and
# long transactions need it; running DDL through the pooler fails in ways that
# are hard to diagnose.

# Note: on newer Supabase projects `db.PROJECT.supabase.co` resolves only to
# IPv6. Where that cannot be routed, both strings go through the pooler, as
# above. Special characters in the password must be URL-encoded — `!` is `%21`.

DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Tests -------------------------------------------------------------------
# The RLS suite creates and deletes users and households. It must never point at
# a real project, so it uses its own database and skips entirely when unset.

TEST_DATABASE_URL=postgresql://USER@127.0.0.1:5432/norte_dev

# Credentials for the authenticated end-to-end suites. A confirmed account on
# the target project. Absent, those suites skip and say so.
# E2E_EMAIL=
# E2E_PASSWORD=

# --- Cloudflare R2 -----------------------------------------------------------
# Private financial documents. Never a public bucket; every read is a signed URL
# with a short expiry (spec §46, §122).

R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Tooling escape hatch ----------------------------------------------------
# Lets a build, lint run or e2e suite import application code without real
# credentials. Never set this in a deployed environment.
# SKIP_ENV_VALIDATION=true
